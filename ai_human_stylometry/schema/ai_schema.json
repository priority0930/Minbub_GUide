{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIGeneratedSample",
  "description": "AI generated corpus JSONL 한 줄(=한 샘플)의 스키마. docs/research_design.md §5.2 와 동일하다.",
  "type": "object",
  "required": [
    "sample_id", "pair_id", "group", "label", "ai_model", "model_version",
    "generation_date", "temperature", "prompt_id",
    "genre", "domain", "topic", "purpose", "audience", "style",
    "main_message", "generated_text", "text_char_count", "text_word_count"
  ],
  "properties": {
    "sample_id": { "type": "string", "pattern": "^A[0-9]{3,4}$", "description": "예: A001" },
    "pair_id": { "type": "string", "pattern": "^P[0-9]{3,4}$", "description": "대응하는 Human 샘플과 공유하는 pair 식별자" },
    "group": { "const": "ai_generated" },
    "label": { "const": 1, "description": "분류 라벨: AI=1" },
    "ai_model": { "type": "string", "description": "예: claude, chatgpt, gemini" },
    "model_version": { "type": "string", "description": "예: claude-sonnet-5" },
    "generation_date": { "type": "string", "format": "date", "description": "YYYY-MM-DD" },
    "temperature": { "type": ["number", "null"], "description": "생성 시 사용한 temperature (알 수 없으면 null)" },
    "prompt_id": { "type": "string", "description": "build_ai_prompt()가 생성한 프롬프트의 식별자 (pair_id와 1:1 대응 권장)" },
    "genre": { "type": "string", "description": "대응 Human 샘플과 동일하게 맞춤" },
    "domain": { "type": "string" },
    "topic": { "type": "string" },
    "purpose": { "type": "string" },
    "audience": { "type": "string" },
    "style": { "type": "string" },
    "main_message": { "type": "string", "description": "생성된 글의 핵심 메시지(연구자 또는 AI 요약). 분류 feature로는 사용하지 않음" },
    "generated_text": { "type": "string", "description": "AI가 metadata만으로 생성한 텍스트. 인간 원문을 참고하지 않았어야 함" },
    "text_char_count": { "type": "integer", "minimum": 0 },
    "text_word_count": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
